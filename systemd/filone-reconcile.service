[Unit]
# Make the node match origin/main. Started by filone-reconcile.timer every five
# minutes; a change reaches this node by being merged.
Description=FilOne node reconcile
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
# The checkout lives where /etc/fil-one/node.conf says: /opt/fil-one on the
# cloud nodes, /root/fil-one on the bare-metal staging host. systemd will not
# take a variable as the program itself, hence bash in front.
EnvironmentFile=/etc/fil-one/node.conf
ExecStart=/bin/bash ${FILONE_CHECKOUT}/scripts/host/reconcile.sh

# Long enough for an image pull, a proving-window wait and both health gates.
# Shorter than this and a deploy that is working normally gets killed halfway.
TimeoutStartSec=4200

# A failed pass is retried after 1 minute, then about 1m45s, about 3 minutes,
# and every 5 minutes from then on, the timer's own cadence. After a reboot that
# brings the Piris and Ingot back within minutes when the first pass fails, for
# example on an OpenBao that has not unsealed yet. A successful pass resets the
# sequence. The one-minute floor and five-minute cap keep a broken commit from
# turning this into a tight loop, and deploy-apps.sh pulls only the Piri and
# Ingot images the host does not have.
#
# RestartSteps and RestartMaxDelaySec need systemd 254 or later.
Restart=on-failure
RestartSec=1min
RestartSteps=3
RestartMaxDelaySec=5min
