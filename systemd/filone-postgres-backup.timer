[Unit]
Description=Push a Postgres base backup of the FilOne node daily

[Timer]
# Persistent catches up on a day the box was off. Enabled by the platform deploy
# and the reconcile pass, on a node that takes backups, while Postgres runs with
# archiving on, and disabled by them while it does not.
OnCalendar=daily
RandomizedDelaySec=30m
Persistent=true

[Install]
WantedBy=timers.target
