[Unit]
# Keep the OpenBao seal token alive at central. OpenBao renews it itself while
# it runs; this covers the gap when it has not been running.
Description=FilOne node OpenBao seal token renewal
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# The checkout lives where /etc/fil-one/node.conf says: /opt/fil-one on the
# cloud nodes, /root/fil-one on the bare-metal staging host. systemd will not
# take a variable as the program itself, hence bash in front.
EnvironmentFile=/etc/fil-one/node.conf
ExecStart=/bin/bash ${FILONE_CHECKOUT}/scripts/host/renew-seal-token.sh
TimeoutStartSec=300
