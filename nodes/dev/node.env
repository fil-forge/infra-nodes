# Everything about the dev node that is not a secret.
#
# Read by every host script and passed to `docker compose --env-file`, so a
# value used by both a script and a compose file is stated once, here. Secrets
# come from the node's own OpenBao and never appear in this file.

# Which directory under nodes/ this is. The host scripts read the same value
# from /etc/filone/node.conf and refuse to run if the two disagree.
FILONE_NODE=dev

# The stage this node belongs to. Several nodes can share one stage, so this is
# not the node's identity: it names the group that talks to one set of central
# services. Telemetry labels are built from it, and the `node` label is what
# tells two nodes in the same stage apart.
STAGE=dev

# The virtual S3 region this node presents. Ingot's config, hilt's provider
# registration and every client's AWS_REGION have to carry the same string.
REGION_LABEL=us-east-9

# --- This node's public identity -------------------------------------------

PIRI_HOSTNAME=piri.dev.forge-sandbox.fil.one
INGOT_HOSTNAME=ingot.dev.forge-sandbox.fil.one
PIRI_PUBLIC_URL=https://piri.dev.forge-sandbox.fil.one
INGOT_PUBLIC_URL=https://ingot.dev.forge-sandbox.fil.one

# Recorded on-chain when Piri registers.
OPERATOR_EMAIL=eng@fil.one

# --- Identity tooling --------------------------------------------------------

# Binaries that scripts/host/install-tools.sh puts on the host, used only by
# key generation. Upgrading one is a new pin merged here and a re-run of that
# script; the instance is untouched. Each SHA-256 covers the linux arm64
# release archive and is verified before the binary is extracted — these tools
# generate the node's identity keys, so nothing unverified runs.

# From ucantool_<version>_checksums.txt on the release.
UCANTOOL_VERSION=v0.1.0
UCANTOOL_SHA256=d2bdcc84a7b327e2d713c3d985d2aac2b9ed09508933c3e925e08ae6286f02cf

# From the .sha256 asset published alongside the archive. Only cast is
# installed; the rest of the Foundry toolchain is discarded.
FOUNDRY_VERSION=v1.7.1
FOUNDRY_SHA256=c8fe8fa09ae3aba2c81b510c6f9da3a9d468029b9580e690b245b3f0aea687ae

# --- Central services (infra-central, dev stage) ---------------------------

# The central OpenBao this node unseals against, the mount and the key are in
# platform/config/openbao/bao.hcl, which is the file OpenBao actually reads.
# provision-platform.sh reads the address from there too, when it claims the
# seal token, so there is one copy of each and nothing to keep in step.

# Upload service. Piri ships blobs to it; Ingot invokes against it.
SPRUE_URL=https://sprue.dev.forge-sandbox.fil.one
SPRUE_DID=did:web:sprue.dev.forge-sandbox.fil.one

# S3 authorization service. Mints tenant credentials and authorizes every /s3/*
# invocation Ingot makes.
HILT_URL=https://hilt.dev.forge-sandbox.fil.one
HILT_DID=did:web:hilt.dev.forge-sandbox.fil.one

# The registrar Piri calls during init. It refuses any DID that is not on its
# allow list, which is the first of the three writes onboarding performs.
REGISTRAR_URL=https://delegator.dev.forge-sandbox.fil.one

# Signs PDP transactions on the payer's behalf. The payer wallet itself stays
# central and is funded there.
SIGNING_SERVICE_URL=https://signing-service.dev.forge-sandbox.fil.one
SIGNING_SERVICE_DID=did:web:signing-service.dev.forge-sandbox.fil.one

# The address the signing service pays from, read from the central dev stage's
# provision output. docs/RUNBOOK.md says where. Rendering fails while this is
# still the placeholder.
PAYER_ADDRESS=0x0000000000000000000000000000000000000000

# --- Chain access ----------------------------------------------------------

# The chain RPC endpoint Piri dials. WebSocket, not HTTP: Piri watches for
# transaction confirmations through ChainNotify, a streaming subscription that
# only delivers over a WebSocket, and over plain HTTP receipts sit pending
# forever.
#
# A node with its own Lotus, or a different provider, changes this one value.
# The access token that goes with it is a secret and lives in OpenBao.
LOTUS_RPC_URL=wss://calibration.filecoin.chain.love/ws/rpc/v2

# Calibration testnet. Addresses are the deployed proxy contracts, and match the
# ones infra-central's dev stage runs against.
# https://github.com/fil-forge/filecoin-services/blob/main/service_contracts/deployments.json
CHAIN_ID=314159
PDP_VERIFIER_ADDRESS=0x85e366Cf9DD2c0aE37E963d9556F5f4718d6417C
FWSS_ADDRESS=0x0c6875983B20901a7C3c86871f43FdEE77946424
FWSS_VIEW_ADDRESS=0xEAD67d775f36D1d2894854D20e042C77A3CC20a5
SERVICE_PROVIDER_REGISTRY_ADDRESS=0x839e5c9988e4e9977d40708d0094103c0839Ac9D
FILECOIN_PAY_ADDRESS=0x09a0fDc2723fAd1A7b8e3e00eE5DF73841df55a0
USDFC_TOKEN_ADDRESS=0xb3042734b608a1B16e9e86B374A3f3e389B4cDf0

# --- Telemetry -------------------------------------------------------------

# Grafana Cloud push endpoints and their user ids. The token that goes with them
# is a secret and lives in OpenBao. Both ids are visible on the stack's details
# page in Grafana Cloud.
#
# deploy-platform.sh refuses to run while either id is still 000000. Grafana
# rejects a push from that id and Alloy carries on regardless, so a node left
# on the placeholder would deploy green and ship nothing.
GRAFANA_LOGS_URL=https://logs-prod-006.grafana.net/loki/api/v1/push
GRAFANA_LOGS_USER=000000
GRAFANA_METRICS_URL=https://prometheus-prod-006-prod-us-east-0.grafana.net/api/prom/push
GRAFANA_METRICS_USER=000000
