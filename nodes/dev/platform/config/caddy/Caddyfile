# Caddy is the only thing on this node listening on a public interface.
#
# Two public sites, both with certificates Caddy obtains and renews itself over
# ACME. Nothing else: Piri and Ingot reach everything they need directly.

{
	# The admin API, on the container's loopback. The healthcheck reads it; the
	# host does not, because the port is not published.
	admin 127.0.0.1:2019
}

# Piri. Storage protocol endpoints, the readiness probe sprue polls, and the
# node's did:web document.
#
# Ahead of the proxy: the node's own status document, which says which revision
# each project was deployed from and which image digests are running.
# scripts/ci/smoke-test.sh waits on it after a merge. It sits under
# /.well-known/ because RFC 8615 reserves that prefix for site-wide metadata,
# which makes it the one place Piri has no business defining a route. The path
# matcher is exact and carries no wildcard, so the state directory mounted
# behind it serves this one file and nothing else.
https://{$PIRI_HOSTNAME} {
	handle /.well-known/filone-node-status.json {
		root * /srv/filone
		file_server
	}
	handle {
		reverse_proxy piri:3000
	}
}

# Ingot. Addressed path-style: there is no wildcard certificate for
# <bucket>.s3.<region>.<suffix>, so a client using virtual-host addressing
# fails TLS before it reaches anything here.
https://{$INGOT_HOSTNAME} {
	reverse_proxy ingot:9000
}
