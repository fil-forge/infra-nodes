// Telemetry out of the node: journald, container logs, host metrics and the
// deploy stamp, all pushed to Grafana Cloud.
//
// Push-only credentials, so this is a one-way pipe: nothing in Grafana Cloud
// can reach back into the node.
//
// Piri's own application metrics arrive here too, through the OTLP receiver at
// the bottom of this file: Piri pushes them over the compose network and this
// file is the only thing on the node that holds a Grafana token.

logging {
	level  = "info"
	format = "logfmt"
}

// Every series and every log line carries the node and its region label, which
// is what lets one Grafana stack hold every appliance without them running
// together, and an appliance label naming the stage and region in one value.
loki.write "grafana_cloud" {
	endpoint {
		url = sys.env("GRAFANA_LOGS_URL")

		basic_auth {
			username = sys.env("GRAFANA_LOGS_USER")
			password = sys.env("GRAFANA_PUSH_TOKEN")
		}
	}

	external_labels = {
		node      = sys.env("FILONE_NODE"),
		region    = sys.env("REGION_LABEL"),
		appliance = sys.env("APPLIANCE_LABEL"),
	}
}

prometheus.remote_write "grafana_cloud" {
	endpoint {
		url = sys.env("GRAFANA_METRICS_URL")

		basic_auth {
			username = sys.env("GRAFANA_METRICS_USER")
			password = sys.env("GRAFANA_PUSH_TOKEN")
		}
	}

	external_labels = {
		node      = sys.env("FILONE_NODE"),
		region    = sys.env("REGION_LABEL"),
		appliance = sys.env("APPLIANCE_LABEL"),
	}
}

// The host's journal: cloud-init, the reconcile timer, docker itself, and any
// unit that fails. This is where a failed deploy is legible after the fact.
loki.source.journal "host" {
	forward_to = [loki.write.grafana_cloud.receiver]

	// The journal is the host itself, not any one container, so it carries the
	// -host service name rather than a per-unit one. The unit is on its own
	// label below, which is what narrows a query to the failing timer.
	labels = {
		job          = "journal",
		service_name = sys.env("SERVICE_NAME_PREFIX") + "-host",
	}

	relabel_rules = loki.relabel.journal.rules
}

loki.relabel "journal" {
	forward_to = []

	rule {
		source_labels = ["__journal__systemd_unit"]
		target_label  = "unit"
	}
}

// Container logs, discovered rather than listed, so a service added to either
// compose project starts shipping without a change here.
discovery.docker "containers" {
	host = "unix:///var/run/docker.sock"
}

discovery.relabel "containers" {
	// The Docker log source applies these rules to each entry's metadata.
	targets = []

	rule {
		source_labels = ["__meta_docker_container_name"]
		regex         = "/(.*)"
		target_label  = "container"
	}

	rule {
		source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
		target_label  = "compose_project"
	}

	// The label Grafana groups a service by, built from the compose service
	// name. Two nodes in the same stage and region deliberately share it: it
	// names the service, and the node label is what tells the instances apart.
	rule {
		source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
		// (.+) rather than the default (.*): a container started by hand carries
		// no compose label, and the rule skips it instead of shipping a name
		// that ends in a dash.
		regex        = "(.+)"
		replacement  = sys.env("SERVICE_NAME_PREFIX") + "-$1"
		target_label = "service_name"
	}
}

loki.source.docker "containers" {
	host          = "unix:///var/run/docker.sock"
	targets       = discovery.docker.containers.targets
	labels        = {job = "docker"}
	relabel_rules = discovery.relabel.containers.rules
	forward_to    = [loki.write.grafana_cloud.receiver]
}

// Host metrics, plus the textfile collector, which is how a shell script gets a
// metric into Prometheus: the deploy scripts write deploy.prom into this
// directory and Alloy picks it up on the next scrape.
//
// The collector list is deliberately short. Anything that needs a host mount
// this container does not have — cgroups for cAdvisor, the dbus socket for the
// systemd collector — is left out rather than shipped broken; container health
// is already visible through the deploy gate and the journal.
//
// netdev is out for the same reason and cannot be brought back by a mount:
// /proc/net resolves through /proc/self, so it reports whichever network
// namespace the reader is in. Only host network mode would give this container
// the appliance's interfaces, and that would also put Alloy's own listener on
// the host.
//
// The three paths below point the remaining collectors at the host mounts in
// compose.yml. Without them, filesystem would report the container's overlay
// and describe none of the EBS volumes this node's capacity actually depends
// on.
prometheus.exporter.unix "host" {
	set_collectors = ["cpu", "diskstats", "filesystem", "loadavg", "meminfo", "textfile"]

	rootfs_path = "/host/root"
	procfs_path = "/host/proc"
	sysfs_path  = "/host/sys"

	textfile {
		directory = "/metrics"
	}
}

prometheus.scrape "host" {
	targets         = prometheus.exporter.unix.host.targets
	forward_to      = [prometheus.relabel.host.receiver]
	scrape_interval = "60s"
}

// service_name goes on the series rather than in external_labels, which would
// stamp every series the writer carries. Once Piri and Ingot expose their own
// /metrics through the same writer, their series need their own names.
prometheus.relabel "host" {
	forward_to = [prometheus.remote_write.grafana_cloud.receiver]

	rule {
		replacement  = sys.env("SERVICE_NAME_PREFIX") + "-host"
		target_label = "service_name"
	}

	// The exporter runs inside this container, so the scrape's instance label
	// is the container's hostname: a Docker id that changes on every recreate
	// and restarts every series under a new label set. Name the node instead.
	rule {
		replacement  = sys.env("FILONE_NODE")
		target_label = "instance"
	}
}

// Caddy's own metrics: request counts, durations and sizes per site, handler,
// method and status code. Every public response the node gives passes through
// Caddy, so this is the one scrape that sees all of them.
// Caddy serves them on an unpublished HTTP listener that only this network
// reaches; the Caddyfile says why it is not the admin API.
prometheus.scrape "caddy" {
	targets         = [{__address__ = "caddy:2020"}]
	job_name        = "caddy"
	forward_to      = [prometheus.relabel.caddy.receiver]
	scrape_interval = "60s"
}

prometheus.relabel "caddy" {
	forward_to = [prometheus.remote_write.grafana_cloud.receiver]

	// Caddy counts this scrape's own requests like any other. They would sit
	// in every denominator, so the series recorded under the metrics server
	// are dropped here. `up` carries no server label and passes through.
	rule {
		source_labels = ["server"]
		regex         = "metrics"
		action        = "drop"
	}

	rule {
		replacement  = sys.env("SERVICE_NAME_PREFIX") + "-caddy"
		target_label = "service_name"
	}

	// Same reason as the host relabel above: the scrape's instance label would
	// be `caddy:2020`, and the node name is the value every other series uses.
	rule {
		replacement  = sys.env("FILONE_NODE")
		target_label = "instance"
	}
}

// Piri's own application metrics: its job queues, its IPNI advertisement
// backlog, HTTP server latency, the free space behind its data directory and
// its build. Piri exposes no /metrics endpoint and pushes OTLP instead, so
// this is a receiver rather than a scrape, and the apps project points Piri at
// it by compose service name. Its PDP proving carries no instrumentation, so
// nothing about proving arrives here.
//
// Nothing outside this network can reach it: the container publishes no port,
// and the receiver is unauthenticated on the assumption that the compose
// network is the trust boundary, as it already is for Postgres.
//
// Metrics only. Piri emits spans but samples none of its own — it only
// continues a trace another service started — and there is no trace backend
// to forward them to, so no traces output is wired.
otelcol.receiver.otlp "apps" {
	http { }

	output {
		metrics = [otelcol.exporter.prometheus.apps.input]
	}
}

// OTLP metrics into Prometheus series. Resource attributes do not become
// labels on each series: service.name becomes `job`, service.instance.id
// becomes `instance`, and the rest is carried by a `target_info` series which
// a query joins on those two labels. Piri's version and node DID are read
// from there.
otelcol.exporter.prometheus "apps" {
	forward_to = [prometheus.relabel.apps.receiver]
}

prometheus.relabel "apps" {
	forward_to = [prometheus.remote_write.grafana_cloud.receiver]

	// The same service_name this node's container logs carry, built from the
	// `job` label the conversion set, so Piri's logs and its metrics select
	// under one name. Piri sets no service.namespace, so `job` is the bare
	// service name.
	//
	// A sender must not put an attribute called `job` on a data point: the
	// conversion writes attributes over the target labels, so that name
	// replaces the one taken from service.name and every series here would be
	// named after the attribute instead. Piri's job queues report the job's
	// type as `job_name` for this reason.
	rule {
		source_labels = ["job"]
		regex         = "(.+)"
		replacement   = sys.env("SERVICE_NAME_PREFIX") + "-$1"
		target_label  = "service_name"
	}

	// instance arrives as the node's DID, where every other series on this
	// node carries the node name. Overwrite it on the series and on
	// target_info alike, so the join between them still holds.
	rule {
		replacement  = sys.env("FILONE_NODE")
		target_label = "instance"
	}
}
