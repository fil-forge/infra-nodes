# Pinned images for the apps project. This file is the deploy unit: bumping an
# image here is what a release to this node looks like, and the reconcile timer
# picks it up within five minutes of the merge.
#
# Both are pinned to a digest. The tag is left on for readability; docker pulls
# the digest and ignores it.
#
# Nothing edits this file by hand. Piri and Ingot dispatch their new digest when
# they publish, .github/workflows/bump-deployed-image.yml opens the pull request,
# and scripts/ci/set-node-pin.sh writes the line. That script is also how to
# write one from a terminal; docs/RUNBOOK.md has both escape hatches.
#
# One blank line between the entries, so two bumps in flight do not conflict.

PIRI_IMAGE=ghcr.io/fil-forge/piri:main@sha256:5bf2215de60279df38f9409928d4c691ace7279cd65e9ab2c770b9c465ff8764

INGOT_IMAGE=ghcr.io/fil-forge/ingot:main@sha256:1ef08c4f656f20653d8c9baf80247d3ab457cb45d51ee99f79b48a30bc0faa2c
