# Pinned images for the apps project. This file is the deploy unit: bumping an
# image here is what a release to this node looks like, and the reconcile timer
# picks it up within five minutes of the merge.
#
# The rolling :main tags are for bring-up. Pin to an immutable digest before the
# node carries anything worth keeping:
#   docker buildx imagetools inspect ghcr.io/fil-forge/piri:main

PIRI_IMAGE=ghcr.io/fil-forge/piri:main
INGOT_IMAGE=ghcr.io/fil-forge/ingot:main
