# Pinned images for the apps project. This file is the deploy unit: bumping an
# image here is what a release to this node looks like, and the reconcile timer
# picks it up within five minutes of the merge.
#
# Both are pinned to a digest. The tag is left on for readability; docker pulls
# the digest and ignores it. To bump one, read the new digest off the tag and
# replace the line:
#   docker buildx imagetools inspect ghcr.io/fil-forge/piri:main
#
# One blank line between the entries, so two bumps in flight do not conflict.

PIRI_IMAGE=ghcr.io/fil-forge/piri:main@sha256:1c16bc57b560b0215b2973dff86c09d0403e8460ea449bbc64df9a9c70e23f21

INGOT_IMAGE=ghcr.io/fil-forge/ingot:main@sha256:ad42ce055288ff8e3cd12e6ac7e67d31a44a3fc0d4dfa2bbc5b2ac572cb4f3dc
