# Pinned images for the apps project. This file is the deploy unit, and the
# reconcile timer picks up a change within five minutes of the merge.
#
# Seeded with the digests staging/eu-central-3 pinned on 2026-11-18. A new pin
# arrives through "Promote staging's images to prod/us-east-2", the pull request
# promote-prod.yml keeps on bot/promote-prod-us-east-2, which a person merges.
#
# One blank line between the entries, so two bumps in flight do not conflict.

PIRI_IMAGE=ghcr.io/fil-forge/piri:main@sha256:4f8233528890591ac2f1a7b43591e6b6c52e2a4ee8a23d3d04a595ea96a67a48

INGOT_IMAGE=ghcr.io/fil-forge/ingot:main@sha256:f007a11e441a7158485f54ce3af73ca5cae4baea530d3beca6c7b990f7b530ea

# The import service, from another repository's releases, as a private image.
# No release exists yet, so this is the placeholder deploy-import.sh refuses.
# Pin it as <image>:<release tag>@sha256:<digest>, the digest the release notes
# give; deploy-import.sh refuses a reference without one.
IMPORT_SERVICE_IMAGE=PLACEHOLDER
