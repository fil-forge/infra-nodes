# Pinned images for the apps project. This file is the deploy unit, and the
# reconcile timer picks up a change within five minutes of the merge.
#
# Seeded with the digests staging/eu-central-3 pinned on 2026-11-18. A new pin
# arrives through "Promote staging's images to prod/us-east-2", the pull request
# promote-prod.yml keeps on bot/promote-prod-us-east-2, which a person merges.
#
# One blank line between the entries, so two bumps in flight do not conflict.

PIRI_IMAGE=ghcr.io/fil-forge/piri:main@sha256:583a508f25027ed1c5789e2c67fd370710290eafca228260f26574189cc4cfa1

INGOT_IMAGE=ghcr.io/fil-forge/ingot:main@sha256:2777fa76aabfa606e6ae233c33e6dc48e4d7956a6573b19e27db1f2b8714c856
