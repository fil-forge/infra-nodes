# Everything about the prod/us-east-2 appliance on the IST-1 host that is not a
# secret. Bare metal, like staging/eu-central-3, but with Caddy and Alloy in the
# platform project as on dev: nothing else on this host serves its traffic or
# ships its telemetry.
#
# docs/RUNBOOK.md lists the values still at a placeholder, under the
# prod/us-east-2 appliance. The host scripts refuse each of them:
# deploy-apps.sh stops on INGOT_LOCAL_BLOB_MAX_BYTES and the empty object
# storage settings; install-tools.sh on an empty TARGET_PLATFORM.
FILONE_NODE=prod/us-east-2
STAGE=prod
REGION_LABEL=us-east-2

# Out of test-nodes.yml while the node is brought up. The prod stage is not one
# of the tested stages either (scripts/ci/test-nodes/select.sh).
FILONE_TESTED=false

# The node's state lives on the ZFS pool, in the datasets
# scripts/host/bootstrap-prod-us-east-2.sh creates. control is the parent of
# the postgres, openbao and state datasets; ingot is the parent of Ingot's
# segments and blobs datasets. lib.sh's defaults are the cloud nodes' paths.
FILONE_CONTROL_DIR=/mnt/data/fil-one/control
FILONE_DATA_DIR=/mnt/data/fil-one/ingot

# --- This node's public identity -------------------------------------------

# Each Piri answers at piri-<n>.$PIRI_HOSTNAME_SUFFIX, the n matching its
# compose service. Prod's central names carry no stage label.
PIRI_HOSTNAME_SUFFIX=us-east-2.fil-forge.com
# The name central's onboarding addresses this Ingot by: s3.<region>.<ingot
# hostname suffix>, with filonecontent.com as prod's suffix.
INGOT_HOSTNAME=s3.us-east-2.filonecontent.com
INGOT_PUBLIC_URL=https://s3.us-east-2.filonecontent.com
INGOT_DID=did:web:s3.us-east-2.filonecontent.com

# Ingot's byte budget for its spool and cache, which have the ingot/blobs
# dataset to themselves. Bootstrap sizes that dataset from the pool and prints
# the budget, 80% of its quota, at the end of every run; commit that value
# here. 0 is the placeholder, and deploy-apps.sh refuses it.
INGOT_LOCAL_BLOB_MAX_BYTES=0

# Recorded on-chain when Piri registers. The team address dev and staging
# commit.
OPERATOR_EMAIL=eng@fil.one

# The S3-compatible object storage Piri keeps its blobs in, through the
# [repo.s3] section of apps/config/piri/piri-base-config.toml.tpl. Empty until
# the storage exists. Its access key id and secret key are secrets, stored in
# OpenBao at filone/external by provision-platform.sh once the endpoint is set.
PIRI_S3_ENDPOINT=
PIRI_S3_BUCKET_PREFIX=

# This node pushes its Postgres and OpenBao backups to central's prod backup
# bucket, as staging does to staging's.
FILONE_TAKES_BACKUPS=true

# --- Identity tooling --------------------------------------------------------

# The installer verifies this target against the host architecture, and each
# SHA-256 covers the release archive for it. Empty until the host's
# architecture is recorded, which install-tools.sh refuses. The versions are
# staging's.
TARGET_PLATFORM=
UCANTOOL_VERSION=v0.1.0
UCANTOOL_SHA256=
FOUNDRY_VERSION=v1.7.1
FOUNDRY_SHA256=

# --- Central services (infra-central, prod stage) --------------------------

# The central OpenBao this node unseals against, the mount and the key are in
# platform/config/openbao/bao.hcl.

SPRUE_URL=https://upload.fil-forge.com
SPRUE_DID=did:web:upload.fil-forge.com
HILT_URL=https://auth.fil-forge.com
HILT_DID=did:web:auth.fil-forge.com
SWARF_URL=https://revoke.fil-forge.com
SWARF_DID=did:web:revoke.fil-forge.com
PLC_DIRECTORY_URL=https://plc.fil-forge.com
REGISTRAR_URL=https://delegator.fil-forge.com
SIGNING_SERVICE_URL=https://signer.fil-forge.com
SIGNING_SERVICE_DID=did:web:signer.fil-forge.com

# The address the prod signing service pays from, read from the central prod
# stage's provision output. docs/RUNBOOK.md says where.
PAYER_ADDRESS=0x003D9Df37cCD7EB821975cB749D208743002C87D

# --- Chain access ----------------------------------------------------------

# The chain RPC endpoint Piri dials, over a WebSocket for the reason the dev
# node.env gives. Staging's Calibration endpoint, since this node runs on
# Calibration for now. The access token that goes with it is a secret and
# lives in OpenBao.
LOTUS_RPC_URL=wss://calibration.filecoin.chain.love/ws/rpc/v1

# Calibration testnet, as central's prod stage runs for now. The chain id and
# the FWSS, Filecoin Pay, registry and USDFC addresses are the `chain` block of
# fil-forge/infra-central's terraform/envs/prod/platform/terraform.tfvars.
# Central's prod files name no PDP verifier or FWSS view address. Both are
# what that FWSS contract returns from pdpVerifierAddress() and
# viewContractAddress(), and they match dev's and staging's.
CHAIN_ID=314159
PDP_VERIFIER_ADDRESS=0x85e366Cf9DD2c0aE37E963d9556F5f4718d6417C
FWSS_ADDRESS=0x0c6875983B20901a7C3c86871f43FdEE77946424
FWSS_VIEW_ADDRESS=0xEAD67d775f36D1d2894854D20e042C77A3CC20a5
SERVICE_PROVIDER_REGISTRY_ADDRESS=0x839e5c9988e4e9977d40708d0094103c0839Ac9D
FILECOIN_PAY_ADDRESS=0x09a0fDc2723fAd1A7b8e3e00eE5DF73841df55a0
USDFC_TOKEN_ADDRESS=0xb3042734b608a1B16e9e86B374A3f3e389B4cDf0

# --- Telemetry -------------------------------------------------------------

# Grafana Cloud push endpoints and their user ids; docs/RUNBOOK.md says where
# each is read. Every appliance pushes to the one Grafana Cloud stack: these
# are the dev node's values, and the staging host's Alloy pushes to the same
# stack.
GRAFANA_LOGS_URL=https://logs-prod3.grafana.net/loki/api/v1/push
GRAFANA_LOGS_USER=236723
GRAFANA_METRICS_URL=https://prometheus-prod-10-prod-us-central-0.grafana.net/api/prom/push
GRAFANA_METRICS_USER=475506
GRAFANA_TRACES_URL=tempo-us-central1.grafana.net:443
GRAFANA_TRACES_USER=233235
