# Pinned images for the platform project. This file is the deploy unit: a
# platform change is an edit here, and the reconcile timer picks it up within
# five minutes of the merge.
#
# Each is pinned to the digest of its multi-platform image index, read with
#   docker buildx imagetools inspect <image:tag>
# on 2026-11-18. The tag is left on for readability; docker pulls the digest
# and ignores it. Nothing bumps these automatically: a new pin is a hand edit,
# reviewed like any other change to this node.
#
# Postgres is 18 on Debian bookworm, which keeps its data in
# /var/lib/postgresql/18/docker; compose.yml binds /var/lib/postgresql.

OPENBAO_IMAGE=openbao/openbao:2.6.2@sha256:11fd73a2102cda9c55d5d881a8c3210303146a7ec1e8ac76f526e175c6d24641
POSTGRES_IMAGE=postgres:18-bookworm@sha256:ece55f7868da684e400f82f1030a050718adbdd65c23aa500c486f6e2950dc0f
CADDY_IMAGE=caddy:2.11@sha256:4851e54a46b206517c574821bb5cc67f170d2156041e9fbc4c9193b45e84a75b
ALLOY_IMAGE=grafana/alloy:v1.18.1@sha256:0f4434c92b3e6cdac38bb129b344e1790c246f7b6e2eaffcc16a5fa363240e33
