logging { level = "info" format = "logfmt" }

loki.write "grafana_cloud" {
  endpoint {
    url = sys.env("GRAFANA_LOGS_URL")
    basic_auth { username = sys.env("GRAFANA_LOGS_USER") password = sys.env("GRAFANA_PUSH_TOKEN") }
  }
  external_labels = { node = sys.env("FILONE_NODE"), region = sys.env("REGION_LABEL") }
}

prometheus.remote_write "grafana_cloud" {
  endpoint {
    url = sys.env("GRAFANA_METRICS_URL")
    basic_auth { username = sys.env("GRAFANA_METRICS_USER") password = sys.env("GRAFANA_PUSH_TOKEN") }
  }
  external_labels = { node = sys.env("FILONE_NODE"), region = sys.env("REGION_LABEL") }
}

discovery.docker "containers" { host = "unix:///var/run/docker.sock" }
loki.source.docker "containers" {
  host = "unix:///var/run/docker.sock"
  targets = discovery.docker.containers.targets
  forward_to = [loki.write.grafana_cloud.receiver]
}

prometheus.exporter.unix "host" {
  set_collectors = ["cpu", "diskstats", "filesystem", "loadavg", "meminfo", "textfile"]
  rootfs_path = "/host/root"
  procfs_path = "/host/proc"
  sysfs_path = "/host/sys"
  textfile { directory = "/metrics" }
}
prometheus.scrape "host" {
  targets = prometheus.exporter.unix.host.targets
  forward_to = [prometheus.remote_write.grafana_cloud.receiver]
  scrape_interval = "60s"
}
