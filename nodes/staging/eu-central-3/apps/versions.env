# Pinned images for the apps project. This file is the deploy unit: bumping an
# image here is what a release to this node looks like, and the reconcile timer
# picks it up within five minutes of the merge.
#
# Each is pinned to a digest. The tag is left on for readability; docker pulls
# the digest and ignores it.
#
# Nobody edits the Piri and Ingot pins by hand. Piri and Ingot dispatch their
# new digest when they publish, .github/workflows/bump-deployed-image.yml opens
# the pull request, and scripts/ci/set-node-pin.sh writes the line. That script
# is also how to write one from a terminal; docs/RUNBOOK.md has both escape
# hatches. The RAG images have no bump workflow.
#
# One blank line between the entries, so two bumps in flight do not conflict.

PIRI_IMAGE=ghcr.io/fil-forge/piri:main@sha256:55610c930d51901b6f63bd03ceac913ebe5b1fee1715add05f781410cb529aec

INGOT_IMAGE=ghcr.io/fil-forge/ingot:main@sha256:94627cbb95963b835d7520bd09f59298c43c21d02b3a86e50fbce61163b093a5

RAG_ENGINE_IMAGE=ghcr.io/fil-one/rag-engine:main@sha256:b7d1857369883919a87239e1011bcd9b1691d9cd9938f88f630546fd204caa70

RAG_EMBED_IMAGE=ghcr.io/huggingface/text-embeddings-inference:cpu-1.9.4@sha256:2538ea1c9640d3763b15af668039d24172d063b42337b0c27796fc2be180c78d
