# Everything about the pilot-mad node that is not a secret.
#
# Read by every host script and passed to `docker compose --env-file`, so a
# value used by both a script and a compose file is stated once, here. Secrets
# come from the node's own OpenBao and never appear in this file.

# This node's path under nodes/. The host scripts read the same value from
# /etc/fil-one/node.conf and refuse to run if the two disagree.
FILONE_NODE=staging/pilot-mad

# The stage this node belongs to: the group that talks to one set of central
# services. eu-central-3 is in the same stage and is a different node.
STAGE=staging

# The virtual S3 region this node presents. Ingot's config, hilt's provider
# registration and every client's AWS_REGION have to carry the same string.
REGION_LABEL=pilot-mad

# --- Where this node keeps its state ---------------------------------------

# The host has no separate FilOne volume, so both sit on the root filesystem
# under one parent. Only data is expected to move: mounting a volume at
# FILONE_DATA_DIR needs no change here, and changing the path itself means this
# line and the two bind mounts in apps/compose.yml.
#
# Control carries the node's identity — the OpenBao raft store, Postgres and
# Caddy's certificates — so it is the one whose loss costs a re-onboarding.
FILONE_CONTROL_DIR=/fil-one/control
FILONE_DATA_DIR=/fil-one/data

# --- This node's public identity -------------------------------------------

# piri-1 because piri-0 on this suffix is the eu-central-3 appliance. Ingot's
# name carries the region label instead, so it needs no index.
PIRI_HOSTNAME=piri-1.staging.fil-forge.com
INGOT_HOSTNAME=s3.pilot-mad.staging.filonecontent.com
PIRI_PUBLIC_URL=https://piri-1.staging.fil-forge.com
INGOT_PUBLIC_URL=https://s3.pilot-mad.staging.filonecontent.com

# INGOT_HOSTNAME with did:web: in front, spelled out because this file is also
# passed to `docker compose --env-file`, which does no expansion. Central
# derives the same string from the region it onboards, so the two must match
# byte for byte or the delegation verifies against nothing.
INGOT_DID=did:web:s3.pilot-mad.staging.filonecontent.com

# Recorded on-chain when Piri registers.
OPERATOR_EMAIL=eng@fil.one

# --- Identity tooling --------------------------------------------------------

# Binaries scripts/host/install-tools.sh puts on the host, used only by key
# generation. Each SHA-256 covers the release archive for this node's
# architecture and is verified before the binary is extracted.
TARGET_PLATFORM=linux_amd64
UCANTOOL_VERSION=v0.1.0
UCANTOOL_SHA256=409ca145a2d7d6f0447488ba33e823155f3a377c0f005bb69868a75fbb8118e9
FOUNDRY_VERSION=v1.7.1
FOUNDRY_SHA256=cf7e688ed0c4c48adffca788b496076e31060b67ac5afe1e43dbb5499c20c88b

# --- Central services (infra-central, staging stage) ------------------------

SPRUE_URL=https://upload.staging.fil-forge.com
SPRUE_DID=did:web:upload.staging.fil-forge.com
HILT_URL=https://auth.staging.fil-forge.com
HILT_DID=did:web:auth.staging.fil-forge.com
PLC_DIRECTORY_URL=https://plc.staging.fil-forge.com
REGISTRAR_URL=https://delegator.staging.fil-forge.com
SIGNING_SERVICE_URL=https://signer.staging.fil-forge.com
SIGNING_SERVICE_DID=did:web:signer.staging.fil-forge.com

# The address the staging signing service pays from. Read from that stage's
# provision output; this node never holds the money.
PAYER_ADDRESS=0x926bA72CCb2B2b8A9Cd9C69e9eFfFaADfEa50687

# --- Chain access ----------------------------------------------------------

# This host runs no Lotus, so Piri dials the hosted provider and authenticates.
# WebSocket, not HTTP: Piri watches for confirmations through ChainNotify, and
# over plain HTTP receipts sit pending forever. The access token that goes with
# it is a secret and lives in OpenBao.
LOTUS_RPC_URL=wss://calibration.filecoin.chain.love/ws/rpc/v1

# Calibration testnet. The addresses infra-central's staging stage runs against.
CHAIN_ID=314159
PDP_VERIFIER_ADDRESS=0x85e366Cf9DD2c0aE37E963d9556F5f4718d6417C
FWSS_ADDRESS=0x0c6875983B20901a7C3c86871f43FdEE77946424
FWSS_VIEW_ADDRESS=0xEAD67d775f36D1d2894854D20e042C77A3CC20a5
SERVICE_PROVIDER_REGISTRY_ADDRESS=0x839e5c9988e4e9977d40708d0094103c0839Ac9D
FILECOIN_PAY_ADDRESS=0x09a0fDc2723fAd1A7b8e3e00eE5DF73841df55a0
USDFC_TOKEN_ADDRESS=0xb3042734b608a1B16e9e86B374A3f3e389B4cDf0

# --- Telemetry -------------------------------------------------------------

# This host owns no Alloy, so the node runs its own and pushes to the same
# Grafana Cloud stack the dev node uses. All four lines or none: a node.env
# with some of them stops the deploy.
GRAFANA_LOGS_URL=https://logs-prod3.grafana.net/loki/api/v1/push
GRAFANA_LOGS_USER=236723
GRAFANA_METRICS_URL=https://prometheus-prod-10-prod-us-central-0.grafana.net/api/prom/push
GRAFANA_METRICS_USER=475506
