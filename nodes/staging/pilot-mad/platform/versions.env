# Pinned images for the platform project. This file is the deploy unit: a
# platform change is an edit here, and the reconcile timer picks it up within
# five minutes of the merge.
#
# Tags for bring-up. Move each to an immutable digest once there is CI to
# verify one:
#   docker buildx imagetools inspect openbao/openbao:2.6.2

OPENBAO_IMAGE=openbao/openbao:2.6.2
POSTGRES_IMAGE=postgres:16-alpine
CADDY_IMAGE=caddy:2.11
ALLOY_IMAGE=grafana/alloy:v1.18.1
